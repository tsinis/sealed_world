/// Provides {{item}} names translations for different locales.
///
/// **Important**: This mapper is designed for single-use only. Bundled
/// locales are instantiated per [localize] call and never stored in the
/// mapper. Once [localize] returns names, the mapper drops its references to
/// the translations injected via `other` and cannot be reused. Calling
/// [localize] again on the same instance throws an assertion error in debug
/// builds, in release builds it no longer finds the injected translations.
/// Create a new instance if you need to localize again.
// ignore: prefer-match-file-name, it's main library file.
class {{mapper}} extends IsoLocaleMapper<IsoLocaleMapper<String>> {
  /// Provides names translations for {{count}} locales, with the option to
  /// add more translations via the [other] parameter.
  ///
  /// The [other] map is keyed by locale (`"en"`, `"de_CH"`). An entry with
  /// the key of a bundled locale replaces that locale entirely, so to extend
  /// a bundled locale, start from its data class.
  new({Map<String, IsoLocaleMapper<String>>? other})
    : _customLocales = other?.keys.toSet(),
      // A copy: consuming the mapper clears its map, `other` stays intact.
      super(other: {...?other});

  /// The symbol used to identify the alternative/full name of the ISO object.
  static const symbol = "+";

  /// Returns all available locale keys (both lazy and already instantiated).
  ///
  /// Built on first read rather than in the constructor: a mapper is single-use
  /// and most callers never read this, so materializing the full locale set
  /// eagerly would add cost to every [localize] call.
  @override
  // ignore: avoid-late-keyword, deferring this set is the point of the field.
  late final availableLocales = {..._factories.keys, ...?_customLocales};

  /// Locale keys supplied via the `other` constructor parameter, kept apart
  /// from [map] so that [availableLocales] stays correct after consumption.
  final Set<String>? _customLocales;

  bool _isConsumed = false;

  /// Whether the bundled translations include alternative names (entries
  /// keyed `<CODE>+`), derived from the data files by the generator.
  // NOTE for future LLM agents and maintainers: this template is shared by all
  // l10n_* packages. Only l10n_countries bundles alternative (official) names,
  // so it is `true` there and every locale is looked up with the alternative
  // name symbol. In l10n_currencies and l10n_languages it is `false`: bundled
  // locales skip that lookup, it only runs for translations that did not come
  // from [_factories] (e.g. injected via `other`). Never hardcode it, and keep
  // the lookup for bundled locales while it is `true`, otherwise the official
  // country names silently disappear.
  static const _bundlesAltNames = {{bundlesAltNames}};

  /// Whether an `l10n-<locale>=true` define names a locale bundled in this
  /// package (one of [_bundledLocales], e.g. `l10n-de` or `l10n-sw_CD`).
  ///
  /// If so, the mapper switches to "opt-in" mode: it keeps only the locales
  /// enabled by their own define, plus the parent locales they fall back to.
  /// Otherwise it keeps all locales, except those disabled with
  /// `l10n-<locale>=false`. Defines of any other locale (e.g. `l10n-en_US`,
  /// `l10n-pt_BR`, the `l10n-fil` alias, or a locale that only another l10n_*
  /// package bundles) are ignored.
  // ignore: avoid-explicit-type-declaration, the inferred type is not obvious.
  static const bool _hasAnyLocaleFilter =
{{flags}};

  /// Lazy factories — static final means this map is only created once,
  /// and the tear-offs (.new) don't invoke constructors until called.
  static final _factories = <String, IsoLocaleMapper<String> Function()>{
{{factories}}
  };

  /// All locales bundled in this package, whether the `l10n-*` defines of this
  /// build keep them or not. Only [_reportStripped] reads it, from an
  /// `assert`, so release builds do not contain it.
  static const _bundledLocales = {
{{bundledLocales}}
  };

  /// The stripped locales that [_reportStripped] has already reported. Only a
  /// build whose defines strip a locale fills it, which `dart test` does not.
  static final _reported = <String>{}; // coverage:ignore-line

  /// Localizes a set of ISO codes into names (to specified locale if needed).
  ///
  /// Parameters:
  /// - [isoCodes]: Set of ISO codes to be localized.
  /// - [altSymbol]: Optional symbol for alternative (full) name translations.
{{altDoc}}
  /// - [fallbackLocale]: Optional secondary locale for translations.
  /// - [mainLocale]: Optional primary locale for translations.
  /// - [useLanguageFallback]: Whether to also try the parent locales of the
  /// specified ones (i.e. 'en_US' -> 'en', 'zh_Hant_TW' -> 'zh_Hant' -> 'zh').
  /// - [formatter]: Optional callback to modify each translation. It receives
  /// the key of the entry it formats, so the ISO code of an alternative name
  /// ends with the alternative name symbol (`<CODE>+` by default).
  ///
  /// A locale is matched as given first, then normalized (`zh-hant-tw` ->
  /// `zh_Hant_TW`). The returned map follows the lookup order: [mainLocale]
  /// and its parents come before [fallbackLocale] and its parents, so the
  /// first entry of an ISO code is its most specific translation.
  ///
  /// Without [mainLocale] and [fallbackLocale], only the translations injected
  /// via the `other` constructor parameter are used (all of their locales), so
  /// the result is empty if there are none. A call that matches no locale
  /// returns an empty map and does not consume the mapper.
  ///
  /// Returns a [Map] containing the localized names for the provided ISO
  /// codes.
  ///
  /// Example:
  /// ```dart
  /// final mapper = {{mapper}}();
  /// final map = mapper.localize({{example}}, mainLocale: 'en');
  /// print(map);
  /// ```
  LocaleMap localize(
    Set<String> isoCodes, {
    String? altSymbol,
    Object? fallbackLocale,
    Object? mainLocale,
    bool useLanguageFallback = true,
    String Function(LocaleKey isoLocale, String l10n)? formatter,
  }) {
    assert(
      !_isConsumed,
      "A {{mapper}} was used after being consumed. "
      "Once localize() returns names, the mapper drops the translations "
      "injected via `other` and must not be reused. If you need to call "
      "localize() again, create a new {{mapper}} instance.",
    );

    if (isoCodes.isEmpty) return const {};
    final locale = mainLocale?.toString();
    final altLocale = fallbackLocale?.toString();
    assert(
      _reportStripped(locale, useLanguageFallback: useLanguageFallback) &&
          _reportStripped(altLocale, useLanguageFallback: useLanguageFallback),
      "It only reports, it never fails.",
    );
    final localeKeys = locale == null && altLocale == null
        ? null
        : {
            if (locale != null)
              ...LocaleFallback.chain(
                locale,
                useLanguageFallback: useLanguageFallback,
              ),
            if (altLocale != null)
              ...LocaleFallback.chain(
                altLocale,
                useLanguageFallback: useLanguageFallback,
              ),
          };

    final altNameSymbol = altSymbol ?? symbol;
    final results = _Results(isoCodes, formatter);
    bool hasLocale = false;
    // Without locales, every locale injected via `other` is used. Bundled
    // locales are instantiated here, never stored in [map].
    for (final key in localeKeys ?? map.keys) {
      final custom = map[key];
      final names = custom ?? _factories[key]?.call();
      if (names == null) continue;
      hasLocale = true;
      results.addAll(
        names,
        locale: key,
        // Bundled locales skip the lookup when they ship no alternative names.
        altSymbol: custom == null && !_bundlesAltNames ? "" : altNameSymbol,
      );
    }
    if (!hasLocale) return const {}; // Not consumed, can be retried.
    _consume();

    return results.view;
  }

  void _consume() {
    map.clear();
    _isConsumed = true;
  }

  /// Prints a warning the first time a requested [locale] finds none of its
  /// locales in this build because the `l10n-*` defines stripped them.
  /// Otherwise an ignored define strips a language silently: `l10n-en=true`
  /// with `l10n-pt_BR=true` keeps `en` only, so `pt_BR` finds neither `pt_BR`
  /// nor `pt`. A locale that finds one of its parents (`de_CH` -> `de`) is
  /// not reported, and a chain is reported once, by its most specific
  /// stripped locale, whose define keeps the rest of the chain too.
  ///
  /// It is only called from an `assert`, so it always returns `true`, and
  /// release builds neither run nor contain it.
  bool _reportStripped(String? locale, {required bool useLanguageFallback}) {
    final chain = locale == null
        ? const <String>{}
        : LocaleFallback.chain(locale, useLanguageFallback: useLanguageFallback);
    final isFound = chain.any(
      (key) => map.containsKey(key) || _factories.containsKey(key),
    );
    final stripped = isFound
        ? null
        : chain.where(_bundledLocales.contains).firstOrNull;
    // Only a build whose defines strip a locale finds one, which `dart test`
    // does not cover: see the stripped locales test in this package.
    // coverage:ignore-start
    if (stripped != null && _reported.add(stripped)) {
      // ignore: avoid_print, a debug-only warning, the package has no logger.
      print(
        '{{package}}: "$stripped" was stripped by the l10n-* defines, pass '
        "--dart-define=l10n-$stripped=true if it should be kept.",
      );
    }
    // coverage:ignore-end

    return true;
  }
}

/// Collects the names of one [{{mapper}}.localize] call.
///
/// The names keep the lookup order. They are read straight from each locale,
/// without the intermediate map of [IsoLocaleMapper.extract], since
/// `localize` runs on every build.
final class _Results {
  new(this._isoCodes, this._formatter);

  final Set<String> _isoCodes;
  // ignore: prefer-correct-callback-field-name, to match L10N naming.
  final String Function(LocaleKey isoLocale, String l10n)? _formatter;
  final _names = <LocaleKey, String>{};

  /// An unmodifiable view of the names collected so far.
  LocaleMap get view => UnmodifiableMapView(_names);

  /// Adds the [names] of the ISO codes in [locale], each followed by its
  /// alternative name (see [IsoLocaleMapper.altKey]), if there is one.
  void addAll(
    IsoLocaleMapper<String> names, {
    required String locale,
    required String altSymbol,
  }) {
    for (final code in _isoCodes) {
      _add(names, code, locale);
      final altCode = names.altKey(code, altSymbol);
      if (altCode != null) _add(names, altCode, locale);
    }
  }

  void _add(IsoLocaleMapper<String> names, String isoCode, String locale) {
    final l10n = names.map[isoCode];
    if (l10n == null) return;
    final isoLocale = (isoCode: isoCode, locale: locale);
    _names[isoLocale] = _formatter?.call(isoLocale, l10n) ?? l10n;
  }
}
